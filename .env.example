# ---------- REQUIRED ----------
# Postgres. Local: postgresql://postgres:postgres@localhost:5432/yellowcode
# Neon/Supabase: use their connection string (keep ?sslmode=require)
DATABASE_URL=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Local: http://localhost:3000   Vercel: your https URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# First admin login (created by the seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- IMAGE UPLOADS (Cloudinary, free plan ok) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob fallback (used only if Cloudinary keys are empty). Vercel > Storage > Create Blob store > connect to project.
BLOB_READ_WRITE_TOKEN=

# ---------- EMAIL (Resend, optional; quotes still save without it) ----------
RESEND_API_KEY=
MAIL_FROM=Yellow Code <onboarding@resend.dev>
SALES_EMAIL=

# ---------- OPTIONAL ----------
NEXT_PUBLIC_GA_ID=
