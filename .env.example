# ---------- REQUIRED ----------
# Postgres connection string.
# Local Postgres:  postgresql://postgres:postgres@localhost:5432/yellowcode
# Neon:            copy BOTH strings from the Neon dashboard:
#                    - DATABASE_URL below = POOLED string  (host has -pooler)  -> app runtime
#                    - MIGRATE with the DIRECT string    (host has no -pooler) -> npx prisma migrate deploy
# Keep ?sslmode=require on both.
DATABASE_URL=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Local: http://localhost:3000   Vercel: your https URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# First admin login (created by the seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- IMAGE UPLOADS (Vercel Blob is enough to start) ----------
# Vercel > Storage > Create Blob store > Connect to project (adds the token automatically).
BLOB_READ_WRITE_TOKEN=
# Optional: Cloudinary (used instead of Blob when all three keys are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- EMAIL (Resend, optional; quotes still save without it) ----------
RESEND_API_KEY=
MAIL_FROM=Yellow Code <onboarding@resend.dev>
SALES_EMAIL=

# ---------- OPTIONAL ----------
NEXT_PUBLIC_GA_ID=
