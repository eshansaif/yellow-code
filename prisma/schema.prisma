model Bill {
  id          String    @id @default(cuid())
  seq         Int       @unique @default(autoincrement())
  number      String    @unique
  createdById String
  invoices    Invoice[]
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

enum DiscountType {
  PERCENT
  FIXED
}
